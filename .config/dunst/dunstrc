[global]
    monitor = 0
    follow = mouse

    # Position
    origin = top-right
    offset = (12, 12)
    gap_size = 6

    # Size
    width = (200, 380)
    height = (0, 150)
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12

    # Look
    frame_width = 1
    frame_color = "#313244"
    corner_radius = 10
    separator_height = 1
    separator_color = frame

    # Font
    font = JetBrainsMono Nerd Font 11
    line_height = 4

    # Icons
    icon_theme = Adwaita
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    # Timing (in s)
    timeout = 5s

    # Misc
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    # Mouse actions
    mouse_left_click = close_current
    mouse_right_click = close_all
    mouse_middle_click = do_action, close_current

    # History
    sticky_history = yes
    history_length = 20

    # dmenu/rofi for action menu
    dmenu = rofi -dmenu -p "Action:"
    browser = xdg-open

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 4s

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 5s

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 8s

[volume]
    appname = "Volume"
    background = "#1e1e2e"
    foreground = "#f9e2af"
    frame_color = "#f9e2af"
    timeout = 2s

[brightness]
    appname = "Brightness"
    background = "#1e1e2e"
    foreground = "#89b4fa"
    frame_color = "#89b4fa"
    timeout = 2s

[screenshot]
    appname = "Screenshot"
    background = "#1e1e2e"
    foreground = "#a6e3a1"
    frame_color = "#a6e3a1"
    timeout = 3s

[battery_warning]
    appname = "Battery"
    background = "#1e1e2e"
    foreground = "#fab387"
    frame_color = "#fab387"
    timeout=4s

[battery_critical]
    appname = "Battery Critical"
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 8s
